---
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

// Define the props from the collection entry definition
type Props = CollectionEntry<"manuscripts">;

// Generate a new path for every collection entry
export async function getStaticPaths() {
	const manuscripts = await getCollection("manuscripts");
	return manuscripts.map((manuscript) => ({
		params: { slug: manuscript.id },
		props: manuscript,
	}));
}

// Get the manuscript data and render its content
const manuscript = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(manuscript);
---

<BlogLayout {...manuscript.data} minutes={remarkPluginFrontmatter.minutes}>
	<Content />
</BlogLayout>
