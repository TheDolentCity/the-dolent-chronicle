---
import { PageHeader } from "@/components/app/PageHeader";
import PageNavLink from "@/components/app/PageNavLink.astro";
import { PageHomeButton } from "@/components/app/PageHomeButton";
import PageNav from "@/components/app/PageNav.astro";
import PageNavSubsection from "@/components/app/PageNavSubsection.astro";
import PageSection from "@/components/app/PageSection.astro";
import { PageTitle } from "@/components/app/PageTitle";
import { ManuscriptList } from "@/components/manuscripts/Manuscripts";
import BlueskyLogo from "@/components/social/BlueskyLogo.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/constants";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Rss } from "lucide-react";

// Get sorted manuscripts
const manuscripts = (await getCollection("manuscripts")).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<PageSection>
		<PageHeader>
			<PageHomeButton />
			<PageTitle>
				{SITE_TITLE}
			</PageTitle>
		</PageHeader>
		<PageNav>
			<PageNavSubsection>
				<PageNavLink href="/posts" title="See posts archive">Archive</PageNavLink>
				<PageNavLink href="/tags" title="See all post tags">Tags</PageNavLink>
				<PageNavLink href="/about" title="About the Dolent Chronicle">About</PageNavLink>
				<PageNavLink href="/newsletter" title="Sign up to newsletter">Newsletter</PageNavLink>
				<PageNavLink href="/manuscripts" title="See all post tags">Manuscripts</PageNavLink>
			</PageNavSubsection>
			<PageNavSubsection className="grayscale-100">
				<PageNavLink href="/rss.xml" title="RSS file">
					<Rss width="18" height="18" />
				</PageNavLink>
				<PageNavLink href="https://bsky.app/profile/thedolentcity.bsky.social" title="Go to my Bluesky account">
					<BlueskyLogo width="18" height="18" />
				</PageNavLink>
			</PageNavSubsection>
		</PageNav>
		<hr />
		<ManuscriptList {manuscripts} />
	</PageSection>
</BaseLayout>
